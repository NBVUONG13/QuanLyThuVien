<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- PUBLIC URL ONLY. NEVER store database passwords, connection strings or cloud API secrets in WPF. -->
    <add key="SmartLibraryApiBaseUrl" value="https://smartlibrary-api-staging.onrender.com" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
