<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:QuanLyThuVien.ViewModels" xmlns:views="clr-namespace:QuanLyThuVien.Views" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="QuanLyThuVien.Views.FineManagementView" mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="680">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    </UserControl.Resources>
    <StackPanel Margin="0,0,0,24">
        <TextBlock Text="TIỀN PHẠT VÀ THANH TOÁN" FontSize="25" FontWeight="Bold" Foreground="#35294D" Margin="0,0,0,7"/>
        <TextBlock Text="Phạt quá hạn được tính khi trả cuốn theo phiên bản chính sách có hiệu lực." Foreground="#756987" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>
        <Border Background="#F1ECFA" Padding="12" CornerRadius="7" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" Foreground="#553E7C"/>
                <TextBlock Text="{Binding Message}" Foreground="#6B567F" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Width="250" Padding="8,6" Margin="0,0,10,0" ToolTip="Tìm username, mã độc giả hoặc họ tên" MaxLength="80">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanManage}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <Button Content="LÀM MỚI / TÌM" Command="{Binding LoadCommand}" Background="#6951A1" Foreground="White" BorderThickness="0" Padding="16,8"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="265" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã phạt" Binding="{Binding FineId}" Width="70"/>
                <DataGridTextColumn Header="Độc giả" Binding="{Binding ReaderLabel}" Width="175"/>
                <DataGridTextColumn Header="Sách" Binding="{Binding BookTitle}" Width="2*" MinWidth="165"/>
                <DataGridTextColumn Header="Mã cuốn" Binding="{Binding CopyCode}" Width="130"/>
                <DataGridTextColumn Header="Loại" Binding="{Binding FineTypeLabel}" Width="85"/>
                <DataGridTextColumn Header="Phạt (VND)" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="105"/>
                <DataGridTextColumn Header="Đã thu" Binding="{Binding PaidAmount, StringFormat={}{0:N0}}" Width="95"/>
                <DataGridTextColumn Header="Còn nợ" Binding="{Binding Outstanding, StringFormat={}{0:N0}}" Width="100"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="105"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Background="White" BorderBrush="#E6DFF1" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="THANH TOÁN KHOẢN ĐÃ CHỌN" FontWeight="SemiBold" Foreground="#35294D" Margin="0,0,0,9"/>
                <StackPanel Visibility="{Binding CanManage, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="Staff/Admin chỉ ghi nhận sau khi đã thực nhận tiền mặt hoặc xác nhận chuyển khoản." FontSize="12" Foreground="#756987" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,9">
                            <TextBlock Text="Số tiền VND (không dấu chấm/phẩy)" FontSize="12"/>
                            <TextBox Width="195" Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Padding="7,5" MaxLength="12"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,9">
                            <TextBlock Text="Phương thức" FontSize="12"/>
                            <ComboBox Width="150" SelectedValuePath="Tag" SelectedValue="{Binding PaymentMethod, Mode=TwoWay}">
                                <ComboBoxItem Content="Tiền mặt" Tag="cash"/>
                                <ComboBoxItem Content="Chuyển khoản" Tag="bank_transfer"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,9">
                            <TextBlock Text="Mã tham chiếu (nếu chuyển khoản)" FontSize="12"/>
                            <TextBox Width="210" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" Padding="7,5" MaxLength="120"/>
                        </StackPanel>
                    </WrapPanel>
                    <Button Content="GHI NHẬN THANH TOÁN" Command="{Binding PayCommand}" HorizontalAlignment="Left" Padding="19,9" Margin="0,0,0,11" Background="#237553" Foreground="White" BorderThickness="0"/>
                </StackPanel>
                <Button Content="XEM LỊCH SỬ THANH TOÁN CỦA KHOẢN ĐÃ CHỌN" Command="{Binding LoadPaymentsCommand}" HorizontalAlignment="Left" Padding="14,7" Margin="0,0,0,8" Background="#EEE9F7" Foreground="#4E3B6E" BorderThickness="0"/>
                <DataGrid ItemsSource="{Binding Payments}" AutoGenerateColumns="False" IsReadOnly="True" Height="145" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã thu" Binding="{Binding PaymentId}" Width="80"/>
                        <DataGridTextColumn Header="Đã thu (VND)" Binding="{Binding Amount, StringFormat={}{0:N0}}" Width="120"/>
                        <DataGridTextColumn Header="Phương thức" Binding="{Binding MethodLabel}" Width="110"/>
                        <DataGridTextColumn Header="Tham chiếu" Binding="{Binding Reference}" Width="*"/>
                        <DataGridTextColumn Header="Ngày thu" Binding="{Binding PaidAt}" Width="175"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
