<Window x:Class="QuanLyThuVien.Views.LoginHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuanLyThuVien.Views"
        Title="Đăng nhập / Đăng ký - Smart Library"
        Width="920" Height="690" MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hai UserControl dùng chung một host. Chưa có logic xác thực. -->
        <views:LoginWindow Grid.Row="0" Loaded="LoginWindow_Loaded">
            <views:LoginWindow.Style>
                <Style TargetType="{x:Type views:LoginWindow}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=toggleRegister}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:LoginWindow.Style>
        </views:LoginWindow>

        <views:RegisterView Grid.Row="0">
            <views:RegisterView.Style>
                <Style TargetType="{x:Type views:RegisterView}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=toggleRegister}"
                                     Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:RegisterView.Style>
        </views:RegisterView>

        <ToggleButton x:Name="toggleRegister" Grid.Row="1"
                      HorizontalAlignment="Center" Margin="0,10,0,20"
                      Padding="16,8" Background="Transparent" BorderThickness="0"
                      Foreground="#2563EB" FontWeight="SemiBold" Cursor="Hand">
            <ToggleButton.Style>
                <Style TargetType="{x:Type ToggleButton}">
                    <Setter Property="Content" Value="Chưa có tài khoản? Đăng ký"/>
                    <Style.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Content" Value="Đã có tài khoản? Quay lại đăng nhập"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ToggleButton.Style>
        </ToggleButton>
    </Grid>
</Window>
