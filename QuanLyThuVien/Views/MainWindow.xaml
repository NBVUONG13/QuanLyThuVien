<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:QuanLyThuVien.ViewModels" xmlns:views="clr-namespace:QuanLyThuVien.Views" x:Class="QuanLyThuVien.Views.MainWindow" Title="SMART LIBRARY - Khám phá sách" Width="1230" Height="785" MinWidth="920" MinHeight="580" WindowStartupLocation="CenterScreen" Background="#F6F7FC">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#514372"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#775AA0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type vm:LibraryReportsViewModel}">
            <views:LibraryReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BookManagementViewModel}">
            <views:BookManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BookInventoryPage}">
            <views:BookInventoryView DataContext="{Binding Books}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HRManagementViewModel}">
            <views:HRManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReaderManagementViewModel}">
            <views:ReaderManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WalkInCounterPage}">
            <views:WalkInCounterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BorrowReturnViewModel}">
            <views:BorrowReturnView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BorrowRequestViewModel}">
            <views:BorrowRequestView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryPolicyViewModel}">
            <views:LibraryPolicyView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FineManagementViewModel}">
            <views:FineManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotificationCenterViewModel}">
            <views:NotificationCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryMapViewModel}">
            <views:LibraryMapView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReaderDetailPage}">
            <views:ReaderDetailView/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Home is only browse/search; Staff/Admin inventory is its own page. -->
        <DockPanel Grid.Column="0" Background="#312746" LastChildFill="True">
            <Button DockPanel.Dock="Bottom" Content="ĐĂNG XUẤT" Command="{Binding LogoutCommand}" Height="43" Margin="15" FontWeight="SemiBold"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="15,23,15,12">
                    <TextBlock Text="SMART LIBRARY" Foreground="White" FontSize="21" FontWeight="Bold" Margin="4,0,0,5"/>
                    <TextBlock Text="THƯ VIỆN CỦA BẠN" Foreground="#B8A9D4" FontSize="11" Margin="4,0,0,30"/>
                    <Button Style="{StaticResource SideButton}" Content="⌂  Trang chủ" Command="{Binding HomeCommand}"/>
                    <Button Style="{StaticResource SideButton}" Content="⌖  Sơ đồ thư viện" Command="{Binding MapCommand}" ToolTip="Tìm sách, vị trí kệ và chỉ đường 2D"/>
                    <Button Style="{StaticResource SideButton}" Content="▦  Thống kê thư viện" Command="{Binding DashboardCommand}"/>
                    <StackPanel Visibility="{Binding IsReader, Converter={StaticResource BoolVisibility}}">
                        <Button Style="{StaticResource SideButton}" Command="{Binding ReaderCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,10,0"/>
                                <TextBlock Text="Hồ sơ của tôi"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SideButton}" Content="Đặt đơn mượn" Command="{Binding RequestsCommand}" ToolTip="Xem danh mục, chọn 1-5 đầu sách và gửi yêu cầu"/>
                        <Button Style="{StaticResource SideButton}" Content="Mượn &amp; Gia hạn" Command="{Binding LoansCommand}"
                                ToolTip="Đơn đã đặt, lịch sử mượn/trả và yêu cầu gia hạn trong 3 tab"/>
                        <Button Style="{StaticResource SideButton}" Content="Tiền phạt" Command="{Binding FinesCommand}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding CanManage, Converter={StaticResource BoolVisibility}}">
                        <Button Style="{StaticResource SideButton}" Content="📚  Quản lý sách &amp; Kho" Command="{Binding InventoryCommand}" ToolTip="Thêm/sửa đầu sách, nhập kho, quản lý tác giả, thể loại, NXB và xử lý mất/hỏng"/>
                        <TextBlock Text="NGHIỆP VỤ" Foreground="#BAABD6" Margin="12,24,0,8" FontSize="11"/>
                        <Button Style="{StaticResource SideButton}" Content="Quản lý độc giả" Command="{Binding ReaderCommand}"/>
                        <Button Style="{StaticResource SideButton}" Content="★ Duyệt đơn mượn" Command="{Binding RequestsCommand}" ToolTip="Danh sách yêu cầu Reader gửi; xem hồ sơ, duyệt hoặc từ chối."/>
                        <Button Style="{StaticResource SideButton}" Content="Tiếp nhận tại quầy" Command="{Binding CounterCommand}" ToolTip="Chuyển Hồ sơ cũ / Guest mới và tạo đơn tại quầy."/>
                        <Button Style="{StaticResource SideButton}" Content="Thu tiền phạt" Command="{Binding FinesCommand}" ToolTip="Xem tiền phạt và ghi nhận thanh toán tại quầy."/>
                        <Button Style="{StaticResource SideButton}" Content="Lịch sử / Trả sách" Command="{Binding LoansCommand}" ToolTip="Chỉ xem lịch sử phiếu mượn và ghi nhận trả cuốn."/>
                        <Button Style="{StaticResource SideButton}" Content="Chấm công" Command="{Binding AttendanceCommand}" ToolTip="Staff check-in/check-out; Admin xem các ca làm"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="QUẢN TRỊ" Foreground="#BAABD6" Margin="12,24,0,8" FontSize="11"/>
                        <Button Style="{StaticResource SideButton}" Content="Quản lý nhân viên" Command="{Binding StaffCommand}"/>
                        <Button Style="{StaticResource SideButton}" Content="Chính sách thư viện" Command="{Binding PolicyCommand}"/>
                        <Button Style="{StaticResource SideButton}" Content="Báo cáo quản trị" Command="{Binding ReportsCommand}" ToolTip="Thống kê mượn/trả, kho và tiền phạt theo khoảng ngày"/>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
        <!-- Header and bounded content width prevent DataGrid star-column clipping. -->
        <DockPanel Grid.Column="1" LastChildFill="True">
            <Border DockPanel.Dock="Top" Background="#42355E" Padding="24,15">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="KHÁM PHÁ TRI THỨC" Foreground="White" FontWeight="Bold" FontSize="15"/>
                    <!-- Bell stays beside the account name, never navigates away from CurrentPage. -->
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="37" Height="32" Margin="0,0,11,0"
                                  Visibility="{Binding IsReader, Converter={StaticResource BoolVisibility}}">
                                <Button x:Name="NotificationBellButton" Width="34" Height="32"
                                        Background="Transparent" BorderThickness="0" Foreground="White"
                                        Cursor="Hand" Command="{Binding NotificationsCommand}"
                                        ToolTip="Thông báo của tôi">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="White" FontSize="19"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Ellipse Width="9" Height="9" Fill="#EF4444" Stroke="#42355E"
                                         StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         IsHitTestVisible="False"
                                         Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolVisibility}}"/>
                            </Grid>
                            <TextBlock Text="● " Foreground="#8DDDC2" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Username}" Foreground="White" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="  ·  " Foreground="#D5C8E6" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Role}" Foreground="#F2B8F0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- StaysOpen=False: clicking anywhere outside closes the panel.
                             Explicit DataContext protects the separate Popup visual tree. -->
                        <Popup PlacementTarget="{Binding ElementName=NotificationBellButton}"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                               Placement="Bottom" HorizontalOffset="-292" VerticalOffset="9"
                               AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False"
                               IsOpen="{Binding IsNotificationOpen, Mode=TwoWay}">
                            <Border Width="380" Height="440" Background="White"
                                    BorderBrush="#D9CEE9" BorderThickness="1" CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect Color="#29213C" BlurRadius="18" ShadowDepth="4" Opacity="0.22"/>
                                </Border.Effect>
                                <Grid ClipToBounds="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="49"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#453563" CornerRadius="11,11,0,0">
                                        <DockPanel Margin="13,0,8,0">
                                            <Button DockPanel.Dock="Right" Content="✕" Width="29" Height="27"
                                                    Background="Transparent" BorderThickness="0" Foreground="White"
                                                    FontWeight="Bold" Cursor="Hand" Command="{Binding NotificationsCommand}"/>
                                            <TextBlock Text="🔔  THÔNG BÁO" Foreground="White" FontWeight="Bold"
                                                       VerticalAlignment="Center" FontSize="14"/>
                                        </DockPanel>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="12,10,12,8">
                                        <TextBlock Text="{Binding Notifications.UnreadLabel}" FontWeight="SemiBold"
                                                   Foreground="#493766" FontSize="12"/>
                                        <TextBlock Text="{Binding Notifications.Message}" TextWrapping="Wrap"
                                                   Foreground="#726184" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ListBox Grid.Row="2" Margin="12,0,12,7"
                                             ItemsSource="{Binding Notifications.Items}"
                                             SelectedItem="{Binding Notifications.Selected, Mode=TwoWay}"
                                             Background="White" BorderBrush="#E4DEEE"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="9" Margin="2,3" Background="#F8F5FC" CornerRadius="7">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   Foreground="#3D3054" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Body}" FontSize="12" Margin="0,3,0,0"
                                                                   Foreground="#55466C" TextWrapping="Wrap"/>
                                                        <DockPanel Margin="0,6,0,0">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ReadStatus}"
                                                                       Foreground="#735C9D" FontSize="10"/>
                                                            <TextBlock Text="{Binding CreatedAt}" Foreground="#8B7C9C"
                                                                       FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="12,0,12,12">
                                        <Button Content="LÀM MỚI" Command="{Binding Notifications.LoadCommand}"
                                                Background="#6C5198" Foreground="White" BorderThickness="0"
                                                Padding="10,7" Margin="0,0,6,0" Cursor="Hand"/>
                                        <Button Content="ĐÃ ĐỌC" Command="{Binding Notifications.MarkReadCommand}"
                                                Background="#EEE8F7" Foreground="#483760" BorderThickness="0"
                                                Padding="10,7" Margin="0,0,6,0" Cursor="Hand"/>
                                        <Button Content="ĐỌC TẤT CẢ" Command="{Binding Notifications.MarkAllReadCommand}"
                                                Background="#EEE8F7" Foreground="#483760" BorderThickness="0"
                                                Padding="10,7" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <Grid Margin="21,18,21,24" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Status}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"/>
                </Grid>
            </ScrollViewer>
        </DockPanel>
        <!-- Canvas is over the entire window, NOT inside the scrolling content.
             Canvas.Right/Bottom are real pixel anchors independent of row measurement.
             Transparent canvas background does not capture clicks outside the chat. -->
        <Canvas Grid.ColumnSpan="2" Panel.ZIndex="1000"
                Background="{x:Null}"
                Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisibility}}">
            <Border Width="410" Height="515" Canvas.Right="20" Canvas.Bottom="20" CornerRadius="14"
                    Background="White" BorderBrush="#DDD5EB" BorderThickness="1"
                    Visibility="{Binding IsAssistantOpen, Converter={StaticResource BoolVisibility}}">
                <Border.Effect>
                    <DropShadowEffect Color="#36264B" BlurRadius="20" ShadowDepth="3" Opacity="0.22"/>
                </Border.Effect>
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#453563" CornerRadius="13,13,0,0">
                        <DockPanel Margin="14,0,8,0" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="✕" FontSize="17" FontWeight="Bold"
                                    Background="Transparent" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" Width="36" Height="34" ToolTip="Đóng chat"
                                    Command="{Binding AssistantCommand}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✦" FontSize="20" Foreground="#D8C4FF" Margin="0,0,9,0"/>
                                <TextBlock Text="TRỢ LÝ THƯ VIỆN" FontSize="14" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <views:BookAssistantView Grid.Row="1" DataContext="{Binding AssistantPage}"/>
                </Grid>
            </Border>
            <Button Width="58" Height="58" Canvas.Right="20" Canvas.Bottom="20"
                    Command="{Binding AssistantCommand}" Cursor="Hand"
                    ToolTip="Mở trợ lý thư viện" Background="#6C4AA4" Foreground="White"
                    FontSize="17" FontWeight="Bold" BorderThickness="0" Content="AI">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAssistantOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RoundButton" Background="{TemplateBinding Background}"
                                CornerRadius="29" BorderThickness="1" BorderBrush="#9478C2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RoundButton" Property="Background" Value="#8660B9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RoundButton" Property="Background" Value="#4D367C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Canvas>
    </Grid>
</Window>
