<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:QuanLyThuVien.ViewModels" xmlns:views="clr-namespace:QuanLyThuVien.Views" x:Class="QuanLyThuVien.Views.MainWindow" Title="SMART LIBRARY - Khám phá sách" Width="1230" Height="785" MinWidth="920" MinHeight="580" WindowStartupLocation="CenterScreen" Background="#F6F7FC">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#514372"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#775AA0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type vm:LibraryReportsViewModel}">
            <views:LibraryReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BookManagementViewModel}">
            <views:BookManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BookInventoryPage}">
            <views:BookInventoryView DataContext="{Binding Books}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HRManagementViewModel}">
            <views:HRManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReaderManagementViewModel}">
            <views:ReaderManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WalkInCounterPage}">
            <views:WalkInCounterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BorrowReturnViewModel}">
            <views:BorrowReturnView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BorrowRequestViewModel}">
            <views:BorrowRequestView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryPolicyViewModel}">
            <views:LibraryPolicyView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FineManagementViewModel}">
            <views:FineManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotificationCenterViewModel}">
            <views:NotificationCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryMapViewModel}">
            <views:LibraryMapView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReaderDetailPage}">
            <views:ReaderDetailView/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Home is only browse/search; Staff/Admin inventory is its own page. -->
        <DockPanel Grid.Column="0" Background="#312746" LastChildFill="True">
            <Button DockPanel.Dock="Bottom" Content="ĐĂNG XUẤT" Command="{Binding LogoutCommand}" Height="43" Margin="15" FontWeight="SemiBold"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="15,23,15,12">
                    <TextBlock Text="SMART LIBRARY" Foreground="White" FontSize="21" FontWeight="Bold" Margin="4,0,0,5"/>
                    <TextBlock Text="THƯ VIỆN CỦA BẠN" Foreground="#B8A9D4" FontSize="11" Margin="4,0,0,30"/>
                    <Button Style="{StaticResource SideButton}" Content="⌂  Trang chủ" Command="{Binding HomeCommand}"/>
                    <Button Style="{StaticResource SideButton}" Content="⌖  SƠ ĐỒ THƯ VIỆN 2D" Command="{Binding MapCommand}" ToolTip="Tìm sách, vị trí kệ và chỉ đường 2D"/>
                    <Button Style="{StaticResource SideButton}" Content="▦  Thống kê thư viện" Command="{Binding DashboardCommand}"/>
                    <StackPanel Visibility="{Binding IsReader, Converter={StaticResource BoolVisibility}}">
                        <Button Style="{StaticResource SideButton}" Command="{Binding ReaderCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,10,0"/>
                                <TextBlock Text="Hồ sơ của tôi"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SideButton}" Content="ĐẶT ĐƠN MƯỢN SÁCH" Command="{Binding RequestsCommand}" ToolTip="Xem danh mục, chọn 1-5 đầu sách và gửi yêu cầu"/>
                        <Button Style="{StaticResource SideButton}" Content="ĐƠN ĐÃ ĐẶT / LỊCH SỬ" Command="{Binding LoansCommand}"/>
                        <Button Style="{StaticResource SideButton}" Content="{Binding NotificationsMenuText}" Command="{Binding NotificationsCommand}" ToolTip="Thông báo duyệt đơn và gia hạn"/>
                        <Button Style="{StaticResource SideButton}" Content="Gia hạn" Command="{Binding PendingCommand}" CommandParameter="Gia hạn"/>
                        <Button Style="{StaticResource SideButton}" Content="Tiền phạt" Command="{Binding FinesCommand}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding CanManage, Converter={StaticResource BoolVisibility}}">
                        <Button Style="{StaticResource SideButton}" Content="📚  QUẢN LÝ SÁCH &amp; KHO" Command="{Binding InventoryCommand}" ToolTip="Thêm/sửa đầu sách, nhập kho, quản lý tác giả, thể loại, NXB và xử lý mất/hỏng"/>
                        <TextBlock Text="NGHIỆP VỤ" Foreground="#BAABD6" Margin="12,24,0,8" FontSize="11"/>
                        <Button Style="{StaticResource SideButton}" Content="Quản lý độc giả" Command="{Binding ReaderCommand}"/>
                        <Button Style="{StaticResource SideButton}" Content="★ DUYỆT ĐƠN MƯỢN" Command="{Binding RequestsCommand}" ToolTip="Danh sách yêu cầu Reader gửi; xem hồ sơ, duyệt hoặc từ chối."/>
                        <Button Style="{StaticResource SideButton}" Content="TIẾP NHẬN TẠI QUẦY" Command="{Binding CounterCommand}" ToolTip="Chuyển Hồ sơ cũ / Guest mới và tạo đơn tại quầy."/>
                        <Button Style="{StaticResource SideButton}" Content="THU TIỀN PHẠT" Command="{Binding FinesCommand}" ToolTip="Xem tiền phạt và ghi nhận thanh toán tại quầy."/>
                        <Button Style="{StaticResource SideButton}" Content="LỊCH SỬ / TRẢ SÁCH" Command="{Binding LoansCommand}" ToolTip="Chỉ xem lịch sử phiếu mượn và ghi nhận trả cuốn."/>
                        <Button Style="{StaticResource SideButton}" Content="CHẤM CÔNG" Command="{Binding AttendanceCommand}" ToolTip="Staff check-in/check-out; Admin xem các ca làm"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}">
                        <TextBlock Text="QUẢN TRỊ" Foreground="#BAABD6" Margin="12,24,0,8" FontSize="11"/>
                        <Button Style="{StaticResource SideButton}" Content="Quản lý nhân viên" Command="{Binding StaffCommand}"/>
                        <Button Style="{StaticResource SideButton}" Content="Chính sách thư viện" Command="{Binding PolicyCommand}"/>
                        <Button Style="{StaticResource SideButton}" Content="BÁO CÁO QUẢN TRỊ" Command="{Binding ReportsCommand}" ToolTip="Thống kê mượn/trả, kho và tiền phạt theo khoảng ngày"/>
                        <Button Style="{StaticResource SideButton}" Content="Sao lưu dữ liệu" Command="{Binding PendingCommand}" CommandParameter="Sao lưu dữ liệu"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
        <!-- Header and bounded content width prevent DataGrid star-column clipping. -->
        <DockPanel Grid.Column="1" LastChildFill="True">
            <Border DockPanel.Dock="Top" Background="#42355E" Padding="24,15">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="KHÁM PHÁ TRI THỨC" Foreground="White" FontWeight="Bold" FontSize="15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="● " Foreground="#8DDDC2"/>
                        <TextBlock Text="{Binding Username}" Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock Text="  ·  " Foreground="#D5C8E6"/>
                        <TextBlock Text="{Binding Role}" Foreground="#F2B8F0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <Grid Margin="21,18,21,24" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Status}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"/>
                </Grid>
            </ScrollViewer>
        </DockPanel>
        <!-- Reader-only AI assistant: floating above existing pages, never replaces CurrentPage. -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="100" HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Width="410" Margin="0,8,22,20" Visibility="{Binding IsReader, Converter={StaticResource BoolVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" MaxHeight="570" VerticalAlignment="Stretch" CornerRadius="16"
                    Background="White" BorderBrush="#DDD5EB" BorderThickness="1"
                    Visibility="{Binding IsAssistantOpen, Converter={StaticResource BoolVisibility}}">
                <Border.Effect>
                    <DropShadowEffect Color="#36264B" BlurRadius="20" ShadowDepth="3" Opacity="0.2"/>
                </Border.Effect>
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#453563" CornerRadius="15,15,0,0">
                        <DockPanel Margin="16,0,10,0" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="✕" FontSize="17" FontWeight="Bold"
                                    Background="Transparent" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" Width="36" Height="36" ToolTip="Thu gọn trợ lý"
                                    Command="{Binding AssistantCommand}"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✦" FontSize="21" Foreground="#D8C4FF" Margin="0,0,10,0"/>
                                <TextBlock Text="TRỢ LÝ TÌM SÁCH" FontSize="15" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <views:BookAssistantView Grid.Row="1" DataContext="{Binding AssistantPage}"/>
                </Grid>
            </Border>
            <Button Grid.Row="2" Width="58" Height="58" HorizontalAlignment="Right"
                    Command="{Binding AssistantCommand}" Cursor="Hand"
                    ToolTip="Mở / thu gọn trợ lý tìm sách" Background="#6C4AA4" Foreground="White"
                    FontSize="17" FontWeight="Bold" BorderThickness="0" Content="AI">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RoundButton" Background="{TemplateBinding Background}"
                                CornerRadius="29" BorderThickness="1" BorderBrush="#9478C2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RoundButton" Property="Background" Value="#8660B9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RoundButton" Property="Background" Value="#4D367C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>