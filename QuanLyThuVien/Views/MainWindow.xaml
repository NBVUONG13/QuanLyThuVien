<Window x:Class="QuanLyThuVien.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:QuanLyThuVien.ViewModels"
        xmlns:views="clr-namespace:QuanLyThuVien.Views"
        Title="SMART LIBRARY" Width="1190" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F3F6FB">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BookManagementViewModel}"><views:BookManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}"><views:SearchView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HRManagementViewModel}"><views:HRManagementView /></DataTemplate>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#203957"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Background="#15263F" LastChildFill="True">
            <Button DockPanel.Dock="Bottom" Content="ĐĂNG XUẤT" Command="{Binding LogoutCommand}"
                    Height="42" Margin="16" FontWeight="SemiBold" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,24,16,10">
                    <TextBlock Text="SMART LIBRARY" Foreground="White" FontSize="21" FontWeight="Bold" Margin="4,0,0,28"/>
                    <Button Style="{StaticResource MenuButton}" Content="Tổng quan" Command="{Binding DashboardCommand}"/>
                    <Button Style="{StaticResource MenuButton}" Content="Danh mục sách" Command="{Binding BooksCommand}"/>
                    <Button Style="{StaticResource MenuButton}" Content="Tìm kiếm sách" Command="{Binding SearchCommand}"/>
                    <StackPanel Visibility="{Binding IsReader, Converter={StaticResource BoolVisibility}}">
                        <Button Style="{StaticResource MenuButton}" Content="Sách đang mượn" Command="{Binding PendingCommand}" CommandParameter="Sách đang mượn"/>
                        <Button Style="{StaticResource MenuButton}" Content="Gia hạn" Command="{Binding PendingCommand}" CommandParameter="Gia hạn"/>
                        <Button Style="{StaticResource MenuButton}" Content="Tiền phạt" Command="{Binding PendingCommand}" CommandParameter="Tiền phạt"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding CanManage, Converter={StaticResource BoolVisibility}}">
                        <Button Style="{StaticResource MenuButton}" Content="Quản lý độc giả" Command="{Binding PendingCommand}" CommandParameter="Quản lý độc giả"/>
                        <Button Style="{StaticResource MenuButton}" Content="Mượn / trả sách" Command="{Binding PendingCommand}" CommandParameter="Mượn / trả sách"/>
                        <Button Style="{StaticResource MenuButton}" Content="Quản lý bản sao" Command="{Binding BooksCommand}"/>
                        <Button Style="{StaticResource MenuButton}" Content="Tác giả / NXB / Thể loại" Command="{Binding ReferencesCommand}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolVisibility}}">
                        <Button Style="{StaticResource MenuButton}" Content="Quản lý nhân viên" Command="{Binding StaffCommand}"/>
                        <Button Style="{StaticResource MenuButton}" Content="Chấm công / lương" Command="{Binding PendingCommand}" CommandParameter="Chấm công / lương"/>
                        <Button Style="{StaticResource MenuButton}" Content="Chính sách thư viện" Command="{Binding PendingCommand}" CommandParameter="Chính sách thư viện"/>
                        <Button Style="{StaticResource MenuButton}" Content="Sao lưu dữ liệu" Command="{Binding PendingCommand}" CommandParameter="Sao lưu dữ liệu"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
        <DockPanel Grid.Column="1" LastChildFill="True">
            <Border DockPanel.Dock="Top" Background="White" Padding="22,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Xin chào " FontSize="15" Foreground="#334155"/>
                    <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="   |   " FontSize="15"/>
                    <TextBlock Text="{Binding Role}" FontSize="15" Foreground="#2563EB" />
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22,26,30">
                    <TextBlock Text="{Binding Status}" Foreground="#64748B" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <ContentControl Content="{Binding CurrentPage}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
