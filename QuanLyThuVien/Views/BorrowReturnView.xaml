<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:QuanLyThuVien.ViewModels" xmlns:views="clr-namespace:QuanLyThuVien.Views" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="QuanLyThuVien.Views.BorrowReturnView" mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="680">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    </UserControl.Resources>
    <StackPanel Margin="0,0,0,20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="25" Foreground="#6951A1" Margin="0,0,13,0"/>
            <TextBlock Text="MƯỢN SÁCH &amp; GIA HẠN" FontSize="27" FontWeight="Bold" Foreground="#35294D"/>
        </StackPanel>
        <TextBlock Text="Đơn đã đặt, lịch sử mượn/trả và yêu cầu gia hạn trong cùng một trang." FontSize="12" Foreground="#796A8E" Margin="0,0,0,13"/>
        <Border Background="#F0EBF8" BorderBrush="#D7CBEB" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="" Foreground="#6951A1" FontSize="17" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap" Foreground="#514074"/>
            </DockPanel>
        </Border>
        <Button Command="{Binding RefreshCommand}" Height="38" Width="190" Background="#6951A1" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,8,0"/>
                <TextBlock Text="LÀM MỚI PHIẾU MƯỢN"/>
            </StackPanel>
        </Button>
        <!-- Reader: submitted/pending/approved/rejected/cancelled requests (not yet physical loans). -->
        <!-- Step 66: per-copy renewal requests; no separate page and no auto-renewal. -->
        <TabControl Margin="0,3,0,0" Background="White" BorderBrush="#DDD2EE" BorderThickness="1" Padding="3">
            <TabItem Header="Đơn đã đặt" Padding="18,9" FontWeight="SemiBold" Foreground="#483765" Visibility="{Binding IsReader, Converter={StaticResource BoolVisibility}}">
                <views:BorrowRequestHistoryView DataContext="{Binding DataContext.Requests, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Visibility="{Binding DataContext.IsReader, RelativeSource={RelativeSource AncestorType={x:Type views:BorrowReturnView}}, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,16"/>
                <!--Requests use MainWindow.Requests via existing relative binding.-->
            </TabItem>
            <TabItem Header="Lịch sử" Padding="18,9" FontWeight="SemiBold" Foreground="#483765">
                <Border Background="White" BorderBrush="#E6DFF1" BorderThickness="1" CornerRadius="9" Padding="17">
                    <StackPanel>
                        <TextBlock Text="Sách đã nhận / lịch sử trả" FontSize="18" FontWeight="SemiBold" Foreground="#35294D" Margin="0,0,0,5"/>
                        <TextBlock Text="Reader chỉ thấy phiếu của mình. Staff/Admin xem tối đa 100 lượt gần nhất." Foreground="#796A8E" FontSize="12" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding Loans, Mode=OneWay}" SelectedItem="{Binding SelectedLoan, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" Height="340" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Độc giả" Binding="{Binding ReaderUsername, Mode=OneWay}" Width="115" MinWidth="105"/>
                                <DataGridTextColumn Header="Tên sách" Binding="{Binding BookTitle, Mode=OneWay}" Width="2*" MinWidth="220"/>
                                <DataGridTextColumn Header="Mã cuốn" Binding="{Binding CopyCode, Mode=OneWay}" Width="125" MinWidth="110"/>
                                <DataGridTextColumn Header="Mượn lúc" Binding="{Binding BorrowedAt, Mode=OneWay}" Width="158" MinWidth="145"/>
                                <DataGridTextColumn Header="Hạn trả" Binding="{Binding DueAt, Mode=OneWay}" Width="158" MinWidth="145"/>
                                <DataGridTextColumn Header="Đã trả lúc" Binding="{Binding ReturnedAt, Mode=OneWay}" Width="158" MinWidth="145"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status, Mode=OneWay}" Width="95" MinWidth="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Visibility="{Binding CanManage, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="Chọn một phiếu chưa trả rồi nhấn nút dưới để ghi nhận trả." Foreground="#796A8E" Margin="0,12,0,8"/>
                            <Button Command="{Binding ReturnCommand}" Height="40" Width="205" Content="GHI NHẬN TRẢ CUỐN" HorizontalAlignment="Left" Background="#6951A1" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Gia hạn" Padding="18,9" FontWeight="SemiBold" Foreground="#483765">
                <StackPanel>
                    <TextBlock Text="Chọn cuốn đang mượn để xin gia hạn ngay tại tab này." TextWrapping="Wrap" Margin="10,13,10,7" Foreground="#55456D" Visibility="{Binding IsReader, Converter={StaticResource BoolVisibility}}"/>
                    <DataGrid ItemsSource="{Binding Loans}" SelectedItem="{Binding SelectedLoan, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" Height="170" Margin="10,0,10,12" SelectionMode="Single" Visibility="{Binding IsReader, Converter={StaticResource BoolVisibility}}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên sách" Binding="{Binding BookTitle}" Width="2*"/>
                            <DataGridTextColumn Header="Mã cuốn" Binding="{Binding CopyCode}" Width="115"/>
                            <DataGridTextColumn Header="Hạn trả" Binding="{Binding DueAt}" Width="160"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Background="White" BorderBrush="#E6DFF1" BorderThickness="1" CornerRadius="9" Padding="17" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Yêu cầu gia hạn từng cuốn" FontSize="18" FontWeight="SemiBold" Foreground="#35294D" Margin="0,0,0,6"/>
                            <TextBlock Text="Reader chọn cuốn còn đang mượn ở bảng phía trên rồi gửi yêu cầu. Chỉ khi Staff/Admin duyệt, hạn trả mới được đổi theo chính sách hiện hành." TextWrapping="Wrap" Foreground="#796A8E" FontSize="12" Margin="0,0,0,10"/>
                            <Button Content="GỬI YÊU CẦU GIA HẠN CUỐN ĐÃ CHỌN" Command="{Binding RequestRenewalCommand}" Visibility="{Binding IsReader, Converter={StaticResource BoolVisibility}}" Height="38" MinWidth="300" HorizontalAlignment="Left" Background="#6951A1" Foreground="White" BorderThickness="0" Margin="0,0,0,12"/>
                            <DataGrid ItemsSource="{Binding RenewalRequests, Mode=OneWay}" SelectedItem="{Binding SelectedRenewal, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" Height="210" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Độc giả" Binding="{Binding ReaderUsername}" Width="115"/>
                                    <DataGridTextColumn Header="Sách" Binding="{Binding BookTitle}" Width="2*" MinWidth="180"/>
                                    <DataGridTextColumn Header="Mã cuốn" Binding="{Binding CopyCode}" Width="105"/>
                                    <DataGridTextColumn Header="Gửi lúc" Binding="{Binding RequestedAt}" Width="145"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="95"/>
                                    <DataGridTextColumn Header="Lý do/ghi chú" Binding="{Binding ReviewNote}" Width="2*" MinWidth="170"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="HỦY YÊU CẦU GIA HẠN ĐANG CHỜ" Command="{Binding CancelRenewalCommand}" Visibility="{Binding IsReader, Converter={StaticResource BoolVisibility}}" Width="260" Height="36" HorizontalAlignment="Left" Margin="0,10,0,0" Background="#F5EFF9" Foreground="#594079"/>
                            <StackPanel Visibility="{Binding CanManage, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
                                <TextBlock Text="Ghi chú xét duyệt (bắt buộc khi từ chối)" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding RenewalReviewNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Height="36" Padding="8,6" Margin="0,6,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding ApproveRenewalCommand}" Content="DUYỆT GIA HẠN" Width="175" Height="38" Margin="0,0,10,0" Background="#216F54" Foreground="White" BorderThickness="0"/>
                                    <Button Command="{Binding RejectRenewalCommand}" Content="TỪ CHỐI" Width="135" Height="38" Background="#8F4652" Foreground="White" BorderThickness="0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>