<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="QuanLyThuVien.Views.BookInventoryView" Loaded="InventoryView_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="PurpleButton" TargetType="Button">
            <Setter Property="Background" Value="#69519C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style x:Key="InventoryTabStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="19,11"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Foreground" Value="#4C3A71"/>
            <Setter Property="Background" Value="#F0EBF8"/>
            <Setter Property="MinWidth" Value="130"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#5F4790"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <TabControl Margin="0,0,0,0" Background="Transparent" BorderThickness="0" SelectedIndex="0">
            <TabItem Header="SÁCH &amp; NHẬP KHO" Style="{StaticResource InventoryTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6,13,6,24">
                        <DockPanel LastChildFill="True" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource PurpleButton}" Content="TẢI LẠI KHO" Width="125" Height="34" Margin="5,0,0,0" Command="{Binding ReloadInventoryCommand}"/>
                                <Button Style="{StaticResource PurpleButton}" Content="RESET TOÀN BỘ" Width="135" Height="34" Margin="5,0,0,0" Command="{Binding ResetInventoryFormCommand}"/>
                                <Button Style="{StaticResource PurpleButton}" Content="+ SÁCH TIẾP THEO" Width="150" Height="34" Margin="5,0,0,0" Command="{Binding NewInventoryBookCommand}"/>
                            </StackPanel>
                            <TextBlock Text="DANH SÁCH ĐẦU SÁCH" FontSize="17" Foreground="#43365D" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding InventoryMessage}" Foreground="#744E83" TextWrapping="Wrap" FontWeight="Normal" Margin="0,0,0,9"/>
                        <DataGrid ItemsSource="{Binding InventoryBooks}" SelectedItem="{Binding SelectedInventoryBook, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="235" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding BookId}" Width="55"/>
                                <DataGridTextColumn Header="Tên sách" Binding="{Binding Title}" Width="2*" MinWidth="205"/>
                                <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="140"/>
                                <DataGridTextColumn Header="NXB" Binding="{Binding Publisher}" Width="140"/>
                                <DataGridTextColumn Header="Năm" Binding="{Binding PublicationYear}" Width="65"/>
                                <DataGridTextColumn Header="Tổng cuốn" Binding="{Binding TotalCopies}" Width="85"/>
                                <DataGridTextColumn Header="Còn mượn được" Binding="{Binding AvailableCopies}" Width="115"/>
                                <DataGridTextColumn Header="Đang mượn" Binding="{Binding OnLoanCopies}" Width="85"/>
                                <DataGridTextColumn Header="Hiển thị" Binding="{Binding VisibleText}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Expander Header="THÊM / CHỈNH SỬA ĐẦU SÁCH" IsExpanded="False" Margin="0,12,0,14" Padding="10" Background="White" FontWeight="SemiBold">
                            <StackPanel Margin="9">
                                <TextBlock Text="{Binding FormBookHeader}" FontSize="16" Foreground="#594075" FontWeight="Bold"/>
                                <TextBlock Foreground="#3B2C50" Text="Tên sách *" Margin="0,12,0,4"/>
                                <TextBox Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}" Height="35" MaxLength="300" Padding="8,5"/>
                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Foreground="#3B2C50" Text="ISBN (để trống nếu chưa có)" Margin="0,0,0,4"/>
                                        <TextBox Height="35" Text="{Binding FormIsbn, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Padding="8,5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Foreground="#3B2C50" Text="Năm xuất bản" Margin="0,0,0,4"/>
                                        <TextBox Height="35" Text="{Binding FormPublicationYear, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Foreground="#3B2C50" Text="Nhà xuất bản" Margin="0,12,0,4"/>
                                <ComboBox ItemsSource="{Binding Publishers}" SelectedItem="{Binding FormPublisher, Mode=TwoWay}" DisplayMemberPath="Name" Height="35" IsEditable="False"/>
                                <TextBlock Foreground="#3B2C50" Text="Tác giả (chọn được nhiều)" Margin="0,14,0,6"/>
                                <ScrollViewer MaxHeight="125" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding InventoryAuthors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Content="{Binding Name}" Margin="0,0,15,9" MinWidth="150" FontWeight="Normal"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Foreground="#3B2C50" Text="Thể loại (chọn được nhiều)" Margin="0,12,0,6"/>
                                <ScrollViewer MaxHeight="125" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding InventoryCategories}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Content="{Binding Name}" Margin="0,0,15,9" MinWidth="150" FontWeight="Normal"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Foreground="#3B2C50" Text="Mô tả sách" Margin="0,12,0,4"/>
                                <TextBox Text="{Binding FormDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="160" VerticalScrollBarVisibility="Auto" Padding="8,6"/>
                                <CheckBox Content="Cho phép hiển thị sách với độc giả (bỏ chọn sẽ ẩn, không xóa lịch sử)" IsChecked="{Binding FormIsVisible, Mode=TwoWay}" Margin="0,13,0,10"/>
                                <Button Content="LƯU ĐẦU SÁCH" Command="{Binding SaveInventoryBookCommand}" Style="{StaticResource PurpleButton}" Width="195" Height="38" HorizontalAlignment="Left"/>
                                <TextBlock Foreground="#7B6A8B" TextWrapping="Wrap" Margin="0,10,0,0" Text="Sau khi tạo sách mới, form sẽ giữ nguyên tác giả, NXB, thể loại. Chỉ tên, ISBN, mô tả và năm sẽ xóa để nhập sách tiếp theo. Bấm RESET TOÀN BỘ mới xóa lựa chọn danh mục."/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="NHẬP KHO VÀ CẬP NHẬT BẢN SAO" IsExpanded="True" Margin="0,0,0,14" Padding="10" Background="White" FontWeight="SemiBold">
                            <StackPanel Margin="9">
                                <TextBlock Text="Nhập bản sao cho đầu sách đang chọn" FontSize="15" Foreground="#594075"/>
                                <WrapPanel Margin="0,9,0,11" VerticalAlignment="Center">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Foreground="#3B2C50" Text="Số cuốn nhập (1–100)" FontSize="12"/>
                                        <TextBox Text="{Binding BatchQuantity, UpdateSourceTrigger=PropertyChanged}" Height="34" Width="120" Padding="8,5"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Foreground="#3B2C50" Text="Vị trí kệ / ô sách" FontSize="12"/>
                                        <Button Content="{Binding BatchShelf}" Click="ChooseBatchShelf_Click" Height="34" Width="185" Padding="8,5" Background="#F0EBFA" Foreground="#463374" BorderBrush="#BCAFDA" HorizontalContentAlignment="Left" ToolTip="Nhấn để chọn K1–K6, tầng và ô trên sơ đồ thư viện 2D" MinWidth="160"/>
                                        <TextBlock Text="Nhấn để chọn trên sơ đồ 2D" FontSize="10" Foreground="#74648F" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Content="NHẬP CUỐN VÀO KHO" Style="{StaticResource PurpleButton}" Command="{Binding ReceiveStockCommand}" Height="34" Width="175" Margin="0,18,0,0"/>
                                </WrapPanel>
                                <TextBlock Text="Mỗi cuốn nhập sẽ có một mã vật lý riêng. Tổng số lượng tự tính theo danh sách bản sao." Foreground="#7D718B" TextWrapping="Wrap" FontWeight="Normal" Margin="0,0,0,12"/>
                                <DataGrid ItemsSource="{Binding StockCopies}" SelectedItem="{Binding SelectedStockCopy, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Height="215" CanUserDeleteRows="False" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã cuốn" Binding="{Binding CopyCode}" Width="125"/>
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding ConditionStatus}" Width="95"/>
                                        <DataGridTextColumn Header="Vị trí kệ" Binding="{Binding ShelfLocation}" Width="140"/>
                                        <DataGridTextColumn Header="Tình trạng mượn" Binding="{Binding LoanText}" Width="155"/>
                                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding ConditionNote}" Width="2*" MinWidth="170"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{Binding SelectedStockLoanText}" Foreground="#644F84" Margin="0,10,0,6"/>
                                <Border BorderBrush="#E8E0F1" BorderThickness="1" Padding="12" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="CHỈNH TÌNH TRẠNG CUỐN ĐANG Ở KHO" Foreground="#57406F"/>
                                        <WrapPanel Margin="0,9,0,8">
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Foreground="#3B2C50" Text="Tình trạng" FontSize="12"/>
                                                <ComboBox ItemsSource="{Binding StockStatusOptions}" SelectedItem="{Binding CopyStatus, Mode=TwoWay}" Height="34" Width="118"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Foreground="#3B2C50" Text="Kệ mới" FontSize="12"/>
                                                <Button Content="{Binding CopyShelf}" Click="ChooseCopyShelf_Click" Height="34" Width="150" Padding="8,5" Background="#F0EBFA" Foreground="#463374" BorderBrush="#BCAFDA" HorizontalContentAlignment="Left" ToolTip="Nhấn để chọn K1–K6, tầng và ô trên sơ đồ thư viện 2D" MinWidth="160"/>
                                                <TextBlock Text="Nhấn để chọn trên sơ đồ 2D" FontSize="10" Foreground="#74648F" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Foreground="#3B2C50" Text="Ghi chú tình trạng" FontSize="12"/>
                                                <TextBox Text="{Binding CopyNote, UpdateSourceTrigger=PropertyChanged}" Height="34" Width="240" Padding="8,5"/>
                                            </StackPanel>
                                            <Button Content="LƯU TRẠNG THÁI" Command="{Binding SaveStockCopyCommand}" Style="{StaticResource PurpleButton}" Margin="0,16,0,0" Height="34" Width="150"/>
                                        </WrapPanel>
                                        <TextBlock Text="Cuốn đang được mượn không sửa trạng thái ở đây; phải xử lý sự cố bên dưới để cập nhật cả phiếu mượn." FontWeight="Normal" Foreground="#8A5C67" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="MẤT / HỎNG" Style="{StaticResource InventoryTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6,13,6,24">
                        <TextBlock Text="CHỌN ĐẦU SÁCH VÀ CUỐN VẬT LÝ" FontWeight="SemiBold" Foreground="#4C3A71" FontSize="15" Margin="0,0,0,7"/>
                        <DataGrid ItemsSource="{Binding InventoryBooks}" SelectedItem="{Binding SelectedInventoryBook, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="175" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding BookId}" Width="55"/>
                                <DataGridTextColumn Header="Tên sách" Binding="{Binding Title}" Width="2*" MinWidth="205"/>
                                <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="140"/>
                                <DataGridTextColumn Header="NXB" Binding="{Binding Publisher}" Width="140"/>
                                <DataGridTextColumn Header="Năm" Binding="{Binding PublicationYear}" Width="65"/>
                                <DataGridTextColumn Header="Tổng cuốn" Binding="{Binding TotalCopies}" Width="85"/>
                                <DataGridTextColumn Header="Còn mượn được" Binding="{Binding AvailableCopies}" Width="115"/>
                                <DataGridTextColumn Header="Đang mượn" Binding="{Binding OnLoanCopies}" Width="85"/>
                                <DataGridTextColumn Header="Hiển thị" Binding="{Binding VisibleText}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Chọn một cuốn đang mượn để ghi nhận mất hoặc hỏng. Dữ liệu lấy từ phiếu mượn thật." TextWrapping="Wrap" Foreground="#73657F" Margin="0,10,0,9"/>
                        <DataGrid ItemsSource="{Binding StockCopies}" SelectedItem="{Binding SelectedStockCopy, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Height="245" CanUserDeleteRows="False" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã cuốn" Binding="{Binding CopyCode}" Width="125"/>
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding ConditionStatus}" Width="95"/>
                                <DataGridTextColumn Header="Vị trí kệ" Binding="{Binding ShelfLocation}" Width="140"/>
                                <DataGridTextColumn Header="Tình trạng mượn" Binding="{Binding LoanText}" Width="155"/>
                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding ConditionNote}" Width="2*" MinWidth="170"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding SelectedStockLoanText}" Foreground="#644F84" Margin="0,10,0,6"/>
                        <Border BorderBrush="#E8D3D3" BorderThickness="1" Background="#FFF7F5" Padding="12" CornerRadius="6" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="SÁCH ĐANG MƯỢN BỊ MẤT / HỎNG — GHI BỒI THƯỜNG" FontSize="14" Foreground="#983E45"/>
                                <TextBlock Text="Chọn cuốn có trạng thái Đang mượn trong DataGrid. Báo mất sẽ đóng phiếu với lý do lost; báo hỏng là xác nhận nhận trả cuốn hỏng. Phạt quá hạn (nếu có) tính riêng." FontWeight="Normal" TextWrapping="Wrap" Margin="0,7,0,11" Foreground="#715E64"/>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Foreground="#3B2C50" Text="Tiền bồi thường (VND)" FontSize="12"/>
                                        <TextBox Text="{Binding Compensation, UpdateSourceTrigger=PropertyChanged}" Width="165" Height="34" Padding="8,5"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Foreground="#3B2C50" Text="Lý do / tình trạng (ít nhất 8 ký tự)" FontSize="12"/>
                                        <TextBox Text="{Binding IncidentNote, UpdateSourceTrigger=PropertyChanged}" Width="345" Height="34" Padding="8,5"/>
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox Content="Tôi xác nhận đúng cuốn và mức bồi thường; thao tác sẽ đóng phiếu mượn." IsChecked="{Binding ConfirmIncident, Mode=TwoWay}" FontWeight="Normal" Margin="0,12,0,10"/>
                                <WrapPanel>
                                    <Button Content="BÁO MẤT SÁCH" Command="{Binding ReportLostCommand}" Background="#A23B42" Foreground="White" BorderThickness="0" Padding="15,7" Height="38" Margin="0,0,12,0"/>
                                    <Button Content="NHẬN TRẢ SÁCH HỎNG" Command="{Binding ReportDamagedCommand}" Background="#A96A32" Foreground="White" BorderThickness="0" Padding="15,7" Height="38"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding InventoryMessage}" Foreground="#8B4E66" TextWrapping="Wrap" Margin="0,12,0,4"/>
                        <Button Content="TẢI LẠI KHO" Command="{Binding ReloadInventoryCommand}" Height="36" Width="145" HorizontalAlignment="Left" Style="{StaticResource PurpleButton}" Margin="0,7,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="DANH MỤC" Style="{StaticResource InventoryTabStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6,13,6,24">
                        <Button Content="TẢI LẠI DANH MỤC" Command="{Binding LoadReferencesCommand}" Height="34" Width="170" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        <TabControl MinHeight="405">
                            <TabItem Header="Tác giả">
                                <StackPanel Margin="10">
                                    <DataGrid ItemsSource="{Binding Authors}" AutoGenerateColumns="False" IsReadOnly="True" Height="240" CanUserAddRows="False" CanUserDeleteRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
                                            <DataGridTextColumn Header="Tên tác giả" Binding="{Binding Name}" Width="2*" MinWidth="190"/>
                                            <DataGridTextColumn Header="Tiểu sử" Binding="{Binding Detail}" Width="3*" MinWidth="190"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Foreground="#3B2C50" Text="Tên tác giả:" Margin="0,10,0,3"/>
                                    <TextBox Text="{Binding AuthorName, UpdateSourceTrigger=PropertyChanged}" Height="33"/>
                                    <TextBlock Foreground="#3B2C50" Text="Tiểu sử:" Margin="0,6,0,3"/>
                                    <TextBox Text="{Binding AuthorDetail, UpdateSourceTrigger=PropertyChanged}" Height="33"/>
                                    <Button Style="{StaticResource PurpleButton}" Content="THÊM TÁC GIẢ" Command="{Binding AddAuthorCommand}" Height="35" Width="165" HorizontalAlignment="Left" Margin="0,9,0,0"/>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Nhà xuất bản">
                                <StackPanel Margin="10">
                                    <DataGrid ItemsSource="{Binding Publishers}" AutoGenerateColumns="False" IsReadOnly="True" Height="240" CanUserAddRows="False" CanUserDeleteRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
                                            <DataGridTextColumn Header="Tên NXB" Binding="{Binding Name}" Width="2*" MinWidth="190"/>
                                            <DataGridTextColumn Header="Liên hệ" Binding="{Binding Detail}" Width="3*" MinWidth="190"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Foreground="#3B2C50" Text="Tên nhà xuất bản:" Margin="0,10,0,3"/>
                                    <TextBox Text="{Binding PublisherName, UpdateSourceTrigger=PropertyChanged}" Height="33"/>
                                    <TextBlock Foreground="#3B2C50" Text="Thông tin liên hệ:" Margin="0,6,0,3"/>
                                    <TextBox Text="{Binding PublisherDetail, UpdateSourceTrigger=PropertyChanged}" Height="33"/>
                                    <Button Style="{StaticResource PurpleButton}" Content="THÊM NHÀ XUẤT BẢN" Command="{Binding AddPublisherCommand}" Height="35" Width="195" HorizontalAlignment="Left" Margin="0,9,0,0"/>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Thể loại">
                                <StackPanel Margin="10">
                                    <DataGrid ItemsSource="{Binding Categories}" AutoGenerateColumns="False" IsReadOnly="True" Height="240" CanUserAddRows="False" CanUserDeleteRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
                                            <DataGridTextColumn Header="Tên thể loại" Binding="{Binding Name}" Width="*" MinWidth="190"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Foreground="#3B2C50" Text="Tên thể loại mới:" Margin="0,12,0,3"/>
                                    <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Height="33"/>
                                    <Button Style="{StaticResource PurpleButton}" Content="THÊM THỂ LOẠI" Command="{Binding AddCategoryCommand}" Height="35" Width="170" HorizontalAlignment="Left" Margin="0,9,0,0"/>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
