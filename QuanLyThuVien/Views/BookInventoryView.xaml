<UserControl x:Class="QuanLyThuVien.Views.BookInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="PurpleButton" TargetType="Button">
            <Setter Property="Background" Value="#69519C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </UserControl.Resources>
    <StackPanel HorizontalAlignment="Stretch">
        <Border Background="#EFEAFB" Padding="20" CornerRadius="7" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="QUẢN LÝ SÁCH &amp; KHO" FontSize="24" FontWeight="Bold" Foreground="#382853"/>
                <TextBlock Text="Tạo và chỉnh sửa đầu sách · Nhập cuốn vật lý · Cập nhật kệ · Ghi nhận mất/hỏng · Quản lý tác giả, NXB, thể loại" Foreground="#665577" TextWrapping="Wrap" Margin="0,7,0,0"/>
            </StackPanel>
        </Border>
        <Expander Header="ĐẦU SÁCH · SỬA / NHẬP KHO / MẤT HỎNG" IsExpanded="True"
                  Visibility="{Binding CanManage, Converter={StaticResource BoolVisibility}}"
                  Background="White" BorderBrush="#DCD1EC" BorderThickness="1"
                  Padding="12" Margin="0,6,0,20" FontWeight="SemiBold">
            <StackPanel Margin="6,12,6,12">
                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource PurpleButton}" Content="TẢI LẠI KHO"
                                Width="125" Height="34" Margin="5,0,0,0" Command="{Binding ReloadInventoryCommand}"/>
                        <Button Style="{StaticResource PurpleButton}" Content="RESET TOÀN BỘ" Width="135" Height="34" Margin="5,0,0,0" Command="{Binding ResetInventoryFormCommand}"/>
                        <Button Style="{StaticResource PurpleButton}" Content="+ SÁCH TIẾP THEO"
                                Width="150" Height="34" Margin="5,0,0,0" Command="{Binding NewInventoryBookCommand}"/>
                    </StackPanel>
                    <TextBlock Text="QUẢN LÝ KHO SÁCH THẬT" FontSize="17" Foreground="#43365D"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding InventoryMessage}" Foreground="#744E83" TextWrapping="Wrap"
                           FontWeight="Normal" Margin="0,0,0,9"/>
                <DataGrid ItemsSource="{Binding InventoryBooks}" SelectedItem="{Binding SelectedInventoryBook, Mode=TwoWay}"
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" Height="235" SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding BookId}" Width="55" />
                        <DataGridTextColumn Header="Tên sách" Binding="{Binding Title}" Width="2*" MinWidth="205" />
                        <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="140" />
                        <DataGridTextColumn Header="NXB" Binding="{Binding Publisher}" Width="140" />
                        <DataGridTextColumn Header="Năm" Binding="{Binding PublicationYear}" Width="65" />
                        <DataGridTextColumn Header="Tổng cuốn" Binding="{Binding TotalCopies}" Width="85" />
                        <DataGridTextColumn Header="Còn mượn được" Binding="{Binding AvailableCopies}" Width="115" />
                        <DataGridTextColumn Header="Đang mượn" Binding="{Binding OnLoanCopies}" Width="85" />
                        <DataGridTextColumn Header="Hiển thị" Binding="{Binding VisibleText}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
                <TabControl Margin="0,14,0,0" MinHeight="390">
                    <TabItem Header="TẠO / SỬA THÔNG TIN ĐẦU SÁCH">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="490">
                            <StackPanel Margin="13">
                                <TextBlock Text="{Binding FormBookHeader}" FontSize="16" Foreground="#594075" FontWeight="Bold"/>
                                <TextBlock Text="Tên sách *" Margin="0,12,0,4"/>
                                <TextBox Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}" Height="35" MaxLength="300" Padding="8,5"/>
                                <Grid Margin="0,11,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="ISBN (để trống nếu chưa có)" Margin="0,0,0,4"/>
                                        <TextBox Height="35" Text="{Binding FormIsbn, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Padding="8,5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Năm xuất bản" Margin="0,0,0,4"/>
                                        <TextBox Height="35" Text="{Binding FormPublicationYear, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Nhà xuất bản" Margin="0,12,0,4"/>
                                <ComboBox ItemsSource="{Binding Publishers}" SelectedItem="{Binding FormPublisher, Mode=TwoWay}"
                                          DisplayMemberPath="Name" Height="35" IsEditable="False"/>
                                <TextBlock Text="Tác giả (chọn được nhiều)" Margin="0,14,0,6"/>
                                <ScrollViewer MaxHeight="125" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding InventoryAuthors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Content="{Binding Name}"
                                                          Margin="0,0,15,9" MinWidth="150" FontWeight="Normal"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Text="Thể loại (chọn được nhiều)" Margin="0,12,0,6"/>
                                <ScrollViewer MaxHeight="125" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding InventoryCategories}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Content="{Binding Name}"
                                                          Margin="0,0,15,9" MinWidth="150" FontWeight="Normal"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Text="Mô tả sách" Margin="0,12,0,4"/>
                                <TextBox Text="{Binding FormDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="160"
                                         VerticalScrollBarVisibility="Auto" Padding="8,6"/>
                                <CheckBox Content="Cho phép hiển thị sách với độc giả (bỏ chọn sẽ ẩn, không xóa lịch sử)"
                                          IsChecked="{Binding FormIsVisible, Mode=TwoWay}" Margin="0,13,0,10"/>
                                <Button Content="LƯU ĐẦU SÁCH" Command="{Binding SaveInventoryBookCommand}"
                                        Style="{StaticResource PurpleButton}" Width="195" Height="38"
                                        HorizontalAlignment="Left"/>
                                <TextBlock Foreground="#7B6A8B" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="Sau khi tạo sách mới, form sẽ giữ nguyên tác giả, NXB, thể loại. Chỉ tên, ISBN, mô tả và năm sẽ xóa để nhập sách tiếp theo. Bấm RESET TOÀN BỘ mới xóa lựa chọn danh mục."/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="NHẬP KHO / TÌNH TRẠNG / MẤT HỎNG">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="590">
                            <StackPanel Margin="13">
                                <TextBlock Text="Nhập bản sao cho đầu sách đang chọn" FontSize="15" Foreground="#594075"/>
                                <WrapPanel Margin="0,9,0,11" VerticalAlignment="Center">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Số cuốn nhập (1–100)" FontSize="12"/>
                                        <TextBox Text="{Binding BatchQuantity, UpdateSourceTrigger=PropertyChanged}" Height="34" Width="120" Padding="8,5"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Vị trí kệ / ô sách" FontSize="12"/>
                                        <TextBox Text="{Binding BatchShelf, UpdateSourceTrigger=PropertyChanged}" Height="34" Width="185" Padding="8,5"/>
                                    </StackPanel>
                                    <Button Content="NHẬP CUỐN VÀO KHO" Style="{StaticResource PurpleButton}"
                                            Command="{Binding ReceiveStockCommand}" Height="34" Width="175" Margin="0,18,0,0"/>
                                </WrapPanel>
                                <TextBlock Text="Mỗi cuốn nhập sẽ có một mã vật lý riêng. Tổng số lượng tự tính theo danh sách bản sao."
                                           Foreground="#7D718B" TextWrapping="Wrap" FontWeight="Normal" Margin="0,0,0,12"/>
                                <DataGrid ItemsSource="{Binding StockCopies}" SelectedItem="{Binding SelectedStockCopy, Mode=TwoWay}"
                                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                          Height="215" CanUserDeleteRows="False" SelectionMode="Single"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã cuốn" Binding="{Binding CopyCode}" Width="125"/>
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding ConditionStatus}" Width="95"/>
                                        <DataGridTextColumn Header="Vị trí kệ" Binding="{Binding ShelfLocation}" Width="140"/>
                                        <DataGridTextColumn Header="Tình trạng mượn" Binding="{Binding LoanText}" Width="155"/>
                                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding ConditionNote}" Width="2*" MinWidth="170"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{Binding SelectedStockLoanText}" Foreground="#644F84" Margin="0,10,0,6"/>
                                <Border BorderBrush="#E8E0F1" BorderThickness="1" Padding="12" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="CHỈNH TÌNH TRẠNG CUỐN ĐANG Ở KHO" Foreground="#57406F"/>
                                        <WrapPanel Margin="0,9,0,8">
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Tình trạng" FontSize="12"/>
                                                <ComboBox ItemsSource="{Binding StockStatusOptions}" SelectedItem="{Binding CopyStatus, Mode=TwoWay}"
                                                          Height="34" Width="118"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Kệ mới" FontSize="12"/>
                                                <TextBox Text="{Binding CopyShelf, UpdateSourceTrigger=PropertyChanged}" Height="34" Width="150" Padding="8,5"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Ghi chú tình trạng" FontSize="12"/>
                                                <TextBox Text="{Binding CopyNote, UpdateSourceTrigger=PropertyChanged}" Height="34" Width="240" Padding="8,5"/>
                                            </StackPanel>
                                            <Button Content="LƯU TRẠNG THÁI" Command="{Binding SaveStockCopyCommand}"
                                                    Style="{StaticResource PurpleButton}" Margin="0,16,0,0" Height="34" Width="150"/>
                                        </WrapPanel>
                                        <TextBlock Text="Cuốn đang được mượn không sửa trạng thái ở đây; phải xử lý sự cố bên dưới để cập nhật cả phiếu mượn."
                                                   FontWeight="Normal" Foreground="#8A5C67" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="#E8D3D3" BorderThickness="1" Background="#FFF7F5" Padding="12" CornerRadius="6" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="SÁCH ĐANG MƯỢN BỊ MẤT / HỎNG — GHI BỒI THƯỜNG" FontSize="14" Foreground="#983E45"/>
                                        <TextBlock Text="Chọn cuốn có trạng thái Đang mượn trong DataGrid. Báo mất sẽ đóng phiếu với lý do lost; báo hỏng là xác nhận nhận trả cuốn hỏng. Phạt quá hạn (nếu có) tính riêng."
                                                   FontWeight="Normal" TextWrapping="Wrap" Margin="0,7,0,11" Foreground="#715E64"/>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Tiền bồi thường (VND)" FontSize="12"/>
                                                <TextBox Text="{Binding Compensation, UpdateSourceTrigger=PropertyChanged}" Width="165" Height="34" Padding="8,5"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Lý do / tình trạng (ít nhất 8 ký tự)" FontSize="12"/>
                                                <TextBox Text="{Binding IncidentNote, UpdateSourceTrigger=PropertyChanged}" Width="345" Height="34" Padding="8,5"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <CheckBox Content="Tôi xác nhận đúng cuốn và mức bồi thường; thao tác sẽ đóng phiếu mượn."
                                                  IsChecked="{Binding ConfirmIncident, Mode=TwoWay}" FontWeight="Normal" Margin="0,12,0,10"/>
                                        <WrapPanel>
                                            <Button Content="BÁO MẤT SÁCH" Command="{Binding ReportLostCommand}"
                                                    Background="#A23B42" Foreground="White" BorderThickness="0" Padding="15,7"
                                                    Height="38" Margin="0,0,12,0"/>
                                            <Button Content="NHẬN TRẢ SÁCH HỎNG" Command="{Binding ReportDamagedCommand}"
                                                    Background="#A96A32" Foreground="White" BorderThickness="0" Padding="15,7" Height="38"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </Expander>
        <Expander Header="DANH MỤC TÁC GIẢ / NHÀ XUẤT BẢN / THỂ LOẠI" IsExpanded="True"
                  Visibility="{Binding CanManage, Converter={StaticResource BoolVisibility}}"
                  Margin="0,0,0,15" Background="White" Padding="10" FontWeight="SemiBold">
            <StackPanel Margin="8,12,8,12">
                <Button Content="TẢI LẠI DANH MỤC" Command="{Binding LoadReferencesCommand}"
                        Height="34" Width="170" HorizontalAlignment="Left" Margin="0,0,0,10" />
                <TabControl MinHeight="405">
                    <TabItem Header="Tác giả">
                        <StackPanel Margin="10">
                            <DataGrid ItemsSource="{Binding Authors}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Height="240" CanUserAddRows="False" CanUserDeleteRows="False"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" />
                                    <DataGridTextColumn Header="Tên tác giả" Binding="{Binding Name}" Width="2*" MinWidth="190" />
                                    <DataGridTextColumn Header="Tiểu sử" Binding="{Binding Detail}" Width="3*" MinWidth="190" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Tên tác giả:" Margin="0,10,0,3" />
                            <TextBox Text="{Binding AuthorName, UpdateSourceTrigger=PropertyChanged}" Height="33" />
                            <TextBlock Text="Tiểu sử:" Margin="0,6,0,3" />
                            <TextBox Text="{Binding AuthorDetail, UpdateSourceTrigger=PropertyChanged}" Height="33" />
                            <Button Style="{StaticResource PurpleButton}" Content="THÊM TÁC GIẢ"
                                    Command="{Binding AddAuthorCommand}" Height="35" Width="165"
                                    HorizontalAlignment="Left" Margin="0,9,0,0" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Nhà xuất bản">
                        <StackPanel Margin="10">
                            <DataGrid ItemsSource="{Binding Publishers}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Height="240" CanUserAddRows="False" CanUserDeleteRows="False"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" />
                                    <DataGridTextColumn Header="Tên NXB" Binding="{Binding Name}" Width="2*" MinWidth="190" />
                                    <DataGridTextColumn Header="Liên hệ" Binding="{Binding Detail}" Width="3*" MinWidth="190" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Tên nhà xuất bản:" Margin="0,10,0,3" />
                            <TextBox Text="{Binding PublisherName, UpdateSourceTrigger=PropertyChanged}" Height="33" />
                            <TextBlock Text="Thông tin liên hệ:" Margin="0,6,0,3" />
                            <TextBox Text="{Binding PublisherDetail, UpdateSourceTrigger=PropertyChanged}" Height="33" />
                            <Button Style="{StaticResource PurpleButton}" Content="THÊM NHÀ XUẤT BẢN"
                                    Command="{Binding AddPublisherCommand}" Height="35" Width="195"
                                    HorizontalAlignment="Left" Margin="0,9,0,0" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Thể loại">
                        <StackPanel Margin="10">
                            <DataGrid ItemsSource="{Binding Categories}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Height="240" CanUserAddRows="False" CanUserDeleteRows="False"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" />
                                    <DataGridTextColumn Header="Tên thể loại" Binding="{Binding Name}" Width="*" MinWidth="190" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Tên thể loại mới:" Margin="0,12,0,3" />
                            <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Height="33" />
                            <Button Style="{StaticResource PurpleButton}" Content="THÊM THỂ LOẠI"
                                    Command="{Binding AddCategoryCommand}" Height="35" Width="170"
                                    HorizontalAlignment="Left" Margin="0,9,0,0" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>