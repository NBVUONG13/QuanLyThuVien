<UserControl x:Class="QuanLyThuVien.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="900">
    <Grid Background="#F3F6FB">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="710">
                <Border Width="440" Padding="30" Margin="16,18"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="White" CornerRadius="14"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="SMART LIBRARY"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="#2563EB" HorizontalAlignment="Center"/>
                        <TextBlock Text="Đăng ký tài khoản"
                                   FontSize="24" FontWeight="SemiBold" Foreground="#172033"
                                   HorizontalAlignment="Center" Margin="0,8,0,5"/>
                        <TextBlock Text="Chỉ dành cho độc giả (Reader)"
                                   FontSize="12" Foreground="#64748B"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Họ và tên" Margin="0,16,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBox x:Name="txtFullName" IsEnabled="{Binding CanEdit}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0"
                                 VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                 TabIndex="0"/>

                        <TextBlock Text="Tài khoản" Margin="0,12,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBox x:Name="txtRegisterUsername" IsEnabled="{Binding CanEdit}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0"
                                 VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                 TabIndex="1"/>

                        <TextBlock Text="Số điện thoại" Margin="0,12,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBox x:Name="txtRegisterPhone" IsEnabled="{Binding CanEdit}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0"
                                 VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                 ToolTip="Số di động Việt Nam, ví dụ 09xxxxxxxx"
                                 TabIndex="2"/>

                        <TextBlock Text="Mật khẩu" Margin="0,12,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <PasswordBox x:Name="pwdRegisterPassword" IsEnabled="{Binding CanEdit}" Height="40" Padding="10,0"
                                     VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                     TabIndex="3"/>

                        <TextBlock Text="Nhập lại mật khẩu" Margin="0,12,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <PasswordBox x:Name="pwdConfirmPassword" IsEnabled="{Binding CanEdit}" Height="40" Padding="10,0"
                                     VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                     TabIndex="4"/>

                        <Button x:Name="btnRegister" Content="TẠO TÀI KHOẢN"
                                IsEnabled="{Binding CanStart}" Height="44" Margin="0,20,0,0"
                                FontSize="14" FontWeight="SemiBold"
                                Background="#2563EB" Foreground="White"
                                BorderThickness="0" TabIndex="5"/>

                        <TextBlock Text="Mã xác minh (OTP)" Margin="0,20,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBox x:Name="txtRegisterOtp" Text="{Binding Otp, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0"
                                 VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                 MaxLength="6" IsEnabled="{Binding CanConfirm}" TabIndex="6"/>
                        <Button x:Name="btnConfirmOtp" Content="XÁC NHẬN MÃ OTP"
                                IsEnabled="{Binding CanConfirm}" Height="42" Margin="0,12,0,0"
                                FontSize="13" FontWeight="SemiBold"
                                Background="#0F766E" Foreground="White"
                                BorderThickness="0" TabIndex="7"/>

                        <TextBlock x:Name="txtRegisterMessage"
                                   Text="{Binding Message}"
                                   Margin="0,10,0,0" FontSize="11" Foreground="#64748B"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
