<UserControl x:Class="QuanLyThuVien.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="690" d:DesignWidth="920"
             PreviewKeyDown="RegisterView_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="12,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,13,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F3F6FB">
        <!-- Registration form: no OTP field below the form anymore. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="615">
                <Border Width="464" MaxWidth="464" Padding="30,25,30,25" Margin="20,18"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="White" CornerRadius="18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="SMART LIBRARY" FontSize="14" FontWeight="Bold"
                                   Foreground="#2563EB" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tạo tài khoản Reader" FontSize="23" FontWeight="SemiBold"
                                   Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,8,0,5"/>
                        <TextBlock Text="Nhập thông tin để nhận mã xác minh qua email"
                                   FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>

                        <TextBlock Text="Họ và tên" Style="{StaticResource FieldCaptionStyle}" Margin="0,20,0,6"/>
                        <TextBox x:Name="txtFullName" Style="{StaticResource InputStyle}"
                                 Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEdit}" TabIndex="0"/>

                        <TextBlock Text="Tên đăng nhập" Style="{StaticResource FieldCaptionStyle}"/>
                        <TextBox x:Name="txtRegisterUsername" Style="{StaticResource InputStyle}"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEdit}" TabIndex="1"/>

                        <TextBlock Text="Số điện thoại" Style="{StaticResource FieldCaptionStyle}"/>
                        <TextBox x:Name="txtRegisterPhone" Style="{StaticResource InputStyle}"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditPhone}" TabIndex="2"
                                 ToolTip="Số di động Việt Nam, ví dụ 09xxxxxxxx"/>

                        <TextBlock Text="Email nhận mã xác minh" Style="{StaticResource FieldCaptionStyle}"/>
                        <TextBox x:Name="txtRegisterEmail" Style="{StaticResource InputStyle}"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEdit}" TabIndex="3" MaxLength="254"
                                 ToolTip="Email bạn có quyền truy cập để nhận mã OTP"/>

                        <TextBlock Text="Mật khẩu" Style="{StaticResource FieldCaptionStyle}"/>
                        <PasswordBox x:Name="pwdRegisterPassword" Style="{StaticResource PasswordStyle}"
                                     IsEnabled="{Binding CanEdit}" TabIndex="4"/>

                        <TextBlock Text="Nhập lại mật khẩu" Style="{StaticResource FieldCaptionStyle}"/>
                        <PasswordBox x:Name="pwdConfirmPassword" Style="{StaticResource PasswordStyle}"
                                     IsEnabled="{Binding CanEdit}" TabIndex="5"/>

                        <Button x:Name="btnRegister" Content="TẠO TÀI KHOẢN"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="{Binding CanStart}" Margin="0,22,0,0" TabIndex="6"/>

                        <TextBlock x:Name="txtRegisterMessage" Text="{Binding Message}"
                                   Margin="0,11,0,0" FontSize="11" Foreground="#64748B"
                                   TextAlignment="Center" TextWrapping="Wrap"/>

                        <Expander Header="Đã có hồ sơ Guest? Liên hệ Staff để xác minh"
                                  IsExpanded="False" Margin="0,15,0,0"
                                  Foreground="#475569" FontWeight="SemiBold" FontSize="11">
                            <StackPanel Margin="6,9,0,4">
                                <TextBlock Text="Việc liên kết hồ sơ Guest chưa hỗ trợ trên cloud bằng OTP email. Cần xác minh danh tính trực tiếp với Staff."
                                           Foreground="#64748B" FontWeight="Normal" TextWrapping="Wrap"/>
                                <TextBlock Text="Mã liên kết Guest (8 chữ số)" Margin="0,10,0,5"
                                           Foreground="#475569" FontWeight="Normal"/>
                                <TextBox Style="{StaticResource InputStyle}" MaxLength="8"
                                         Text="{Binding GuestClaimCode, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEdit}"/>
                                <Button Content="TẢI HỒ SƠ GUEST" Command="{Binding PreviewGuestCommand}"
                                        IsEnabled="{Binding CanPreviewGuest}"
                                        Style="{StaticResource PrimaryButtonStyle}" Height="36"
                                        Margin="0,8,0,0"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Centered modal OTP step: displayed ONLY when the API accepted the send request. -->
        <Grid x:Name="OtpOverlay" Panel.ZIndex="20" Visibility="Collapsed"
              Background="#B30F172A">
            <Border Width="430" Padding="30" Margin="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" BorderThickness="1" BorderBrush="#E2E8F0" CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect Color="#0F172A" Opacity="0.24"
                                      BlurRadius="24" ShadowDepth="9"/>
                </Border.Effect>
                <Grid>
                    <!-- Enter 6-digit code -->
                    <StackPanel x:Name="OtpEntryPanel">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#EFF6FF"
                                HorizontalAlignment="Center" Margin="0,1,0,15">
                            <TextBlock Text="✉" FontSize="29" Foreground="#2563EB"
                                       FontFamily="Segoe UI Symbol" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Xác minh email" FontSize="23" FontWeight="Bold"
                                   HorizontalAlignment="Center" Foreground="#0F172A"/>
                        <TextBlock Text="Mã xác minh gồm 6 chữ số đã được gửi đến"
                                   FontSize="12" Foreground="#64748B" TextAlignment="Center"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding Email}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1D4ED8" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="Nhập mã xác minh" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#334155" Margin="0,25,0,9"/>
                        <TextBox x:Name="txtRegisterOtp"
                                 Text="{Binding Otp, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanConfirm}"
                                 Height="56" FontSize="28" FontWeight="SemiBold"
                                 FontFamily="Consolas" TextAlignment="Center"
                                 VerticalContentAlignment="Center" BorderThickness="1"
                                 BorderBrush="#93C5FD" Background="#F8FBFF" Foreground="#0F172A"
                                 MaxLength="6" TabIndex="10"
                                 PreviewTextInput="Otp_PreviewTextInput"
                                 DataObject.Pasting="Otp_Pasting"
                                 KeyDown="Otp_KeyDown"/>
                        <TextBlock Text="Mã có hiệu lực 5 phút · Kiểm tra cả thư mục Spam"
                                   FontSize="11" Foreground="#64748B" TextAlignment="Center"
                                   Margin="0,10,0,0"/>

                        <!-- Compact verification button -->
                        <Button x:Name="btnConfirmOtp" Content="Xác minh"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Background="#0F766E" Width="158" Height="43"
                                HorizontalAlignment="Center" Margin="0,22,0,0"
                                IsEnabled="{Binding CanConfirm}" TabIndex="11"/>
                        <TextBlock Text="{Binding Message}" TextAlignment="Center"
                                   TextWrapping="Wrap" Foreground="#475569" FontSize="11"
                                   Margin="0,13,0,0"/>
                        <Button x:Name="btnBackToRegister" Click="BackToRegister_Click"
                                Content="Đổi email / Yêu cầu mã mới"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#2563EB" FontSize="12" Cursor="Hand"
                                HorizontalAlignment="Center" Height="32" Margin="0,9,0,0"/>
                    </StackPanel>

                    <!-- Only shown after API has actually confirmed the OTP and created the account. -->
                    <StackPanel x:Name="OtpSuccessPanel" Visibility="Collapsed">
                        <Border Width="66" Height="66" CornerRadius="33" Background="#ECFDF5"
                                HorizontalAlignment="Center" Margin="0,0,0,18">
                            <TextBlock Text="✓" FontSize="32" FontWeight="Bold" Foreground="#059669"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Đăng ký thành công!" FontSize="22" FontWeight="Bold"
                                   Foreground="#0F172A" TextAlignment="Center"/>
                        <TextBlock Text="Email đã được xác minh. Tài khoản Reader đã sẵn sàng."
                                   FontSize="12" Foreground="#64748B"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,12,0,4"/>
                        <Button Content="Đến trang đăng nhập"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="215" Height="43" HorizontalAlignment="Center"
                                Margin="0,24,0,0" Click="BackToLogin_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
