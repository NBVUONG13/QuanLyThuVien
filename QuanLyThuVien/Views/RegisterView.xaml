<UserControl x:Class="QuanLyThuVien.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="900">
    <Grid Background="#F3F6FB">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="710">
                <Border Width="440" Padding="30" Margin="16,18"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="White" CornerRadius="14"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="SMART LIBRARY"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="#2563EB" HorizontalAlignment="Center"/>
                        <TextBlock Text="Đăng ký tài khoản"
                                   FontSize="24" FontWeight="SemiBold" Foreground="#172033"
                                   HorizontalAlignment="Center" Margin="0,8,0,5"/>
                        <TextBlock Text="Chỉ dành cho độc giả (Reader)"
                                   FontSize="12" Foreground="#64748B"
                                   HorizontalAlignment="Center"/>

                        <!-- Optional section stays collapsed for normal registrations. -->
                        <Expander Header="ĐÃ CÓ HỒ SƠ GUEST? MỞ ĐỂ LIÊN KẾT LỊCH SỬ"
                                  IsExpanded="False" Margin="0,16,0,0" Foreground="#1C4C7D"
                                  FontWeight="SemiBold">
                            <StackPanel Margin="8,10,0,2">
                                <TextBlock Text="Chỉ nhập mã liên kết 8 số do Staff cấp sau khi xác minh danh tính tại quầy. Bấm TẢI HỒ SƠ GUEST để lấy lại họ tên và SĐT cũ. Bạn được sửa họ tên; không cần biết mã guest00001. Đăng ký mới thì bỏ qua mục này."
                                           Foreground="#64748B" FontWeight="Normal" TextWrapping="Wrap" />
                                <TextBlock Text="OTP liên kết 8 số do Staff cấp" Margin="0,9,0,5" Foreground="#334155" />
                                <TextBox Text="{Binding GuestClaimCode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"
                                         MaxLength="8" Height="37" Padding="10,0" VerticalContentAlignment="Center" />
                                <Button Content="TẢI HỒ SƠ GUEST" Command="{Binding PreviewGuestCommand}"
                                        IsEnabled="{Binding CanPreviewGuest}" Height="38" Margin="0,10,0,0"
                                        Background="#2563EB" Foreground="White" BorderThickness="0" />
                                <TextBlock Text="Sau khi tải, tên/SĐT cũ được đưa lên form phía trên. SĐT đã xác minh không sửa tại bước này. CCCD không được trả về ứng dụng."
                                           Foreground="#64748B" FontWeight="Normal" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <TextBlock Text="Họ và tên" Margin="0,16,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBox x:Name="txtFullName" IsEnabled="{Binding CanEdit}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0"
                                 VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                 TabIndex="0"/>

                        <TextBlock Text="Tài khoản" Margin="0,12,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBox x:Name="txtRegisterUsername" IsEnabled="{Binding CanEdit}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0"
                                 VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                 TabIndex="1"/>

                        <TextBlock Text="Số điện thoại" Margin="0,12,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBox x:Name="txtRegisterPhone" IsEnabled="{Binding CanEditPhone}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0"
                                 VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                 ToolTip="Số di động Việt Nam, ví dụ 09xxxxxxxx"
                                 TabIndex="2"/>



                        <TextBlock Text="Mật khẩu" Margin="0,12,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <PasswordBox x:Name="pwdRegisterPassword" IsEnabled="{Binding CanEdit}" Height="40" Padding="10,0"
                                     VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                     TabIndex="3"/>

                        <TextBlock Text="Nhập lại mật khẩu" Margin="0,12,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <PasswordBox x:Name="pwdConfirmPassword" IsEnabled="{Binding CanEdit}" Height="40" Padding="10,0"
                                     VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                     TabIndex="4"/>

                        <Button x:Name="btnRegister" Content="TẠO TÀI KHOẢN"
                                IsEnabled="{Binding CanStart}" Height="44" Margin="0,20,0,0"
                                FontSize="14" FontWeight="SemiBold"
                                Background="#2563EB" Foreground="White"
                                BorderThickness="0" TabIndex="5"/>

                        <TextBlock Text="Mã xác minh (OTP)" Margin="0,20,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBox x:Name="txtRegisterOtp" Text="{Binding Otp, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0"
                                 VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                 MaxLength="6" IsEnabled="{Binding CanConfirm}" TabIndex="6"/>
                        <Button x:Name="btnConfirmOtp" Content="XÁC NHẬN MÃ OTP"
                                IsEnabled="{Binding CanConfirm}" Height="42" Margin="0,12,0,0"
                                FontSize="13" FontWeight="SemiBold"
                                Background="#0F766E" Foreground="White"
                                BorderThickness="0" TabIndex="7"/>

                        <TextBlock x:Name="txtRegisterMessage"
                                   Text="{Binding Message}"
                                   Margin="0,10,0,0" FontSize="11" Foreground="#64748B"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
