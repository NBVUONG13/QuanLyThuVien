<UserControl x:Class="QuanLyThuVien.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900">
    <Grid Background="#F3F6FB">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="555">
                <Border Width="440" Padding="30" Margin="16,18"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="White" CornerRadius="14"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="SMART LIBRARY"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="#2563EB" HorizontalAlignment="Center"/>
                        <TextBlock Text="Đăng ký tài khoản"
                                   FontSize="24" FontWeight="SemiBold" Foreground="#172033"
                                   HorizontalAlignment="Center" Margin="0,8,0,5"/>
                        <TextBlock Text="Xin chào độc giả mới"
                                   FontSize="12" Foreground="#64748B"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Họ và tên" Margin="0,16,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBox x:Name="txtFullName" Height="40" Padding="10,0"
                                 VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                 TabIndex="0"/>

                        <TextBlock Text="Tài khoản" Margin="0,12,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBox x:Name="txtRegisterUsername" Height="40" Padding="10,0"
                                 VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                 TabIndex="1"/>

                        <TextBlock Text="Mật khẩu" Margin="0,12,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <PasswordBox x:Name="pwdRegisterPassword" Height="40" Padding="10,0"
                                     VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                     TabIndex="2"/>

                        <TextBlock Text="Nhập lại mật khẩu" Margin="0,12,0,6"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        <PasswordBox x:Name="pwdConfirmPassword" Height="40" Padding="10,0"
                                     VerticalContentAlignment="Center" BorderBrush="#CBD5E1"
                                     TabIndex="3"/>

                        <Button x:Name="btnRegister" Content="TẠO TÀI KHOẢN"
                                IsEnabled="False" Height="44" Margin="0,20,0,0"
                                FontSize="14" FontWeight="SemiBold"
                                Background="#2563EB" Foreground="White"
                                BorderThickness="0" TabIndex="4"/>
                        <TextBlock x:Name="txtRegisterMessage"
                                   Text="Xin trân trọng được đồng hành cùng quý độc giả"
                                   Margin="0,10,0,0" FontSize="11" Foreground="#64748B"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
