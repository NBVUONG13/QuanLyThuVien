<UserControl x:Class="QuanLyThuVien.Views.LoginWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuanLyThuVien.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <StackPanel HorizontalAlignment="Center" Height="261" Margin="0,102,0,0" VerticalAlignment="Top" Width="800">
            <TextBlock Height="50" TextWrapping="Wrap" Text="Đăng nhập hệ thống" Width="228" FontSize="24" HorizontalAlignment="Center" Margin="0,20,0,0"/>
            <StackPanel Height="40" Width="400" Orientation="Horizontal">
                <Label Content="Tài Khoản" Height="40" Width="100" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                <TextBox TextWrapping="Wrap" Text="" Width="300" Height="40" RenderTransformOrigin="0.5,0.5" TextAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Height="40" Width="400" Orientation="Horizontal">
                <Label Content="Label" Height="40" Width="100" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                <PasswordBox Height="40" Width="300" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" HorizontalContentAlignment="Center"/>
            </StackPanel>
            <Button Content="Button" Height="40" Width="100" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>

    </Grid>
</UserControl>
