<UserControl x:Class="QuanLyThuVien.Views.BookAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="410" d:DesignHeight="496">
    <!-- The BookAssistantViewModel and API are reused unchanged. Compact layout for the floating panel. -->
    <UserControl.Resources>
        <Style x:Key="ChatAction" TargetType="Button">
            <Setter Property="Background" Value="#625092"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="31"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#FAF9FD" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding Status}" Foreground="#6A5786" FontSize="12"
                   TextWrapping="Wrap" Margin="3,0,3,9"/>
        <!-- Dedicated scroll area so long conversations cannot expand the floating window. -->
        <Border Grid.Row="1" CornerRadius="9" BorderBrush="#E4DEEE" BorderThickness="1"
                Background="White" Margin="0,0,0,9">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="9,10">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F1EDF9" CornerRadius="9" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Speaker}" Foreground="#675092"
                                               FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Body}" Foreground="#30263E" FontSize="13"
                                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="2" BorderBrush="#E4DEEE" BorderThickness="1" CornerRadius="9"
                Background="White" Padding="8" Margin="0,0,0,9">
            <StackPanel>
                <TextBlock Text="SÁCH GỢI Ý" FontSize="12" FontWeight="Bold" Foreground="#44325E"
                           Margin="2,0,0,5"/>
                <DataGrid ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" Height="86" RowHeight="26"
                          BorderBrush="#E3DDEC" Background="White"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên sách" Binding="{Binding Title}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="Còn" Binding="{Binding AvailableCopies}" Width="48"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <Button Content="XEM SÁCH" Style="{StaticResource ChatAction}"
                            Command="{Binding OpenBookCommand}" Margin="0,0,8,0"/>
                    <Button Content="TÌM KỆ 2D" Style="{StaticResource ChatAction}"
                            Command="{Binding FindShelfCommand}"/>
                    <TextBlock Text="{Binding SelectedBook.AvailabilityText}" FontSize="11"
                               Foreground="#6A5786" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="3" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="GỬI" Style="{StaticResource ChatAction}"
                    Command="{Binding AskCommand}" Margin="8,0,0,0" Width="58" Height="41"/>
            <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="400" FontSize="13" Foreground="#302740"
                     Background="White" BorderBrush="#CFC6E0" BorderThickness="1"
                     VerticalContentAlignment="Center" Padding="9,4"
                     ToolTip="Nhập câu hỏi, nhấn Enter để gửi">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AskCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
    </Grid>
</UserControl>
