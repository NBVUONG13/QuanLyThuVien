<UserControl x:Class="QuanLyThuVien.Views.BookAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuanLyThuVien.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="410" d:DesignHeight="496">
    <UserControl.Resources>
        <local:PositiveCountVisibilityConverter x:Key="PositiveCountVisible"/>
        <Style x:Key="ChatAction" TargetType="Button">
            <Setter Property="Background" Value="#625092"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="31"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FAF9FD" Margin="9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="105"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Status}" Foreground="#675681" FontSize="11"
                   TextWrapping="Wrap" Margin="3,0,3,8"/>

        <!-- Scroll the conversation, never stretch the floating window with long AI answers. -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E4DEEE" BorderThickness="1"
                CornerRadius="9" Margin="0,0,0,8" ClipToBounds="True">
            <ScrollViewer x:Name="ConversationScrollViewer" Padding="8,10"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Messages}" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="11,9" Margin="0,0,1,9"
                                    BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F5F2FA"/>
                                        <Setter Property="BorderBrush" Value="#E8E0F1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Speaker}" Value="BẠN">
                                                <Setter Property="Background" Value="#EEE9FA"/>
                                                <Setter Property="BorderBrush" Value="#E5DDF6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Speaker}" Foreground="#614B8D"
                                               FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <!-- Convert Markdown * and ** to WPF Inlines, not literal symbols. -->
                                    <TextBlock local:ChatMarkdown.Text="{Binding Body}"
                                               FontSize="13" Foreground="#30263E"
                                               TextWrapping="Wrap" LineHeight="19"
                                               LineStackingStrategy="BlockLineHeight"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Do not reserve space for recommendations when an operational answer has none. -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E4DEEE" BorderThickness="1"
                CornerRadius="9" Padding="8" Margin="0,0,0,8"
                Visibility="{Binding Suggestions.Count, Converter={StaticResource PositiveCountVisible}}">
            <StackPanel>
                <TextBlock Text="SÁCH GỢI Ý TỪ THƯ VIỆN" FontSize="11" FontWeight="Bold"
                           Foreground="#44325E" Margin="2,0,0,5"/>
                <ListBox ItemsSource="{Binding Suggestions}"
                         SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                         MaxHeight="116" Background="White" BorderBrush="#E3DDEC"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4,4"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Title}" ToolTip="{Binding Title}"
                                           TextWrapping="Wrap" Foreground="#372C49" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding AvailableCopies, StringFormat=Còn {0}}"
                                           Foreground="#5E4B83" FontSize="11"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <Button Content="XEM SÁCH" Style="{StaticResource ChatAction}"
                            Command="{Binding OpenBookCommand}" Margin="0,0,7,0"/>
                    <Button Content="TÌM KỆ 2D" Style="{StaticResource ChatAction}"
                            Command="{Binding FindShelfCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding SelectedBook.AvailabilityText}" Foreground="#6A5786"
                           FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="GỬI" Style="{StaticResource ChatAction}"
                    Command="{Binding AskCommand}" Margin="8,0,0,0" Width="58" Height="41"/>
            <TextBox x:Name="QuestionTextBox" KeyDown="QuestionTextBox_KeyDown"
                     Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="400" FontSize="13" Foreground="#302740"
                     Background="White" BorderBrush="#CFC6E0" BorderThickness="1"
                     VerticalContentAlignment="Center" Padding="9,4"
                     ToolTip="Nhập câu hỏi, nhấn Enter để gửi"/>
        </DockPanel>
    </Grid>
</UserControl>