<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:QuanLyThuVien.ViewModels" xmlns:views="clr-namespace:QuanLyThuVien.Views" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="QuanLyThuVien.Views.BorrowRequestHistoryView" mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="680">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    </UserControl.Resources>
    <Border Background="White" CornerRadius="10" BorderThickness="1" BorderBrush="#E2DAEE" Padding="19">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="DANH SÁCH ĐƠN ĐÃ ĐẶT / CHỜ XỬ LÝ" FontSize="18" FontWeight="Bold" Foreground="#35294D"/>
                <Button Command="{Binding RefreshCommand}" Content="LÀM MỚI" DockPanel.Dock="Right" Width="100" Height="35" Background="#6951A1" Foreground="White" BorderThickness="0" HorizontalAlignment="Right"/>
            </DockPanel>
            <TextBlock Text="{Binding Message, Mode=OneWay}" Foreground="#685982" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,7"/>
            <TextBlock Text="Chưa có đơn mượn nào. Bạn có thể đặt đơn trong mục ĐẶT ĐƠN MƯỢN SÁCH." Foreground="#776887" Margin="0,0,0,7" FontStyle="Italic">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Requests.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <DataGrid ItemsSource="{Binding Requests, Mode=OneWay}" SelectedItem="{Binding SelectedRequest, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" Height="280" CanUserAddRows="False" CanUserDeleteRows="False" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã đơn" Binding="{Binding RequestCode, Mode=OneWay}" Width="185" MinWidth="160"/>
                    <DataGridTextColumn Header="Reader" Binding="{Binding ReaderUsername, Mode=OneWay}" Width="120"/>
                    <DataGridTextColumn Header="Nguồn đơn" Binding="{Binding OriginLabel, Mode=OneWay}" Width="105"/>
                    <DataGridTextColumn Header="Ngày gửi" Binding="{Binding RequestedAt, Mode=OneWay}" Width="155"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status, Mode=OneWay}" Width="105"/>
                    <DataGridTextColumn Header="Số đầu sách" Binding="{Binding ItemCount, Mode=OneWay}" Width="90"/>
                    <DataGridTemplateColumn Header="Tình trạng độc giả" Width="200" MinWidth="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" Padding="7,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EEEFF3"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RiskLevel}" Value="green">
                                                    <Setter Property="Background" Value="#D9F2E3"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RiskLevel}" Value="yellow">
                                                    <Setter Property="Background" Value="#FFF0BD"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RiskLevel}" Value="red">
                                                    <Setter Property="Background" Value="#FFD7DA"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RiskLevel}" Value="orange">
                                                    <Setter Property="Background" Value="#FFE3CE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding RiskLabel, Mode=OneWay}" FontWeight="SemiBold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#566276"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RiskLevel}" Value="green">
                                                        <Setter Property="Foreground" Value="#08744A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RiskLevel}" Value="yellow">
                                                        <Setter Property="Foreground" Value="#996700"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RiskLevel}" Value="red">
                                                        <Setter Property="Foreground" Value="#B21E34"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RiskLevel}" Value="orange">
                                                        <Setter Property="Foreground" Value="#A54F06"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Các sách trong đơn" Binding="{Binding ItemsSummary, Mode=OneWay}" Width="2*" MinWidth="260"/>
                    <DataGridTemplateColumn Header="Hồ sơ" Width="135">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="XEM THÀNH VIÊN" Height="29" FontSize="11" Background="#EDE7F7" Foreground="#513877" BorderThickness="0" Command="{Binding DataContext.ViewReaderCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Converter={StaticResource BoolVisibility}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Button Visibility="{Binding IsReader, Converter={StaticResource BoolVisibility}}" Command="{Binding CancelRequestCommand}" Content="HỦY ĐƠN ĐANG CHỌN (CHỈ KHI CHỜ DUYỆT)" Height="38" HorizontalAlignment="Left" Width="330" Margin="0,13,0,0" Background="#B35B5B" Foreground="White" BorderThickness="0"/>
            <Border Visibility="{Binding CanManage, Converter={StaticResource BoolVisibility}}" BorderBrush="#E2DAEE" BorderThickness="1" Background="#FAF8FE" CornerRadius="8" Padding="14" Margin="0,13,0,0">
                <StackPanel>
                    <TextBlock Text="XỬ LÝ ĐƠN ĐƯỢC CHỌN" FontWeight="Bold" Foreground="#35294D" FontSize="15"/>
                    <TextBlock Text="Xanh: đã trả đúng hạn   •   Vàng: từng trả trễ 1–2 lần   •   Đỏ: đang giữ sách quá hạn   •   Cam: trễ nhiều lần   •   Xám: chưa có lịch sử" TextWrapping="Wrap" Foreground="#675777" FontSize="12" Margin="0,7,0,12"/>
                    <TextBlock Text="Chọn đơn, có thể xem chi tiết độc giả trước khi quyết định." Foreground="#776887"/>
                    <Button Command="{Binding ViewReaderCommand}" Content="XEM HỒ SƠ &amp; LỊCH SỬ ĐỘC GIẢ" Width="260" Height="36" Margin="0,9,0,13" HorizontalAlignment="Left" Background="#E9E2F6" Foreground="#493468" BorderThickness="0"/>
                    <TextBlock Text="Ghi chú duyệt / lý do từ chối (bắt buộc khi từ chối)" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding ReviewNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="500" Padding="8" Margin="0,6,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ApproveRequestCommand}" Content="DUYỆT &amp; GIAO ĐỦ CUỐN" Width="213" Height="41" Background="#287C67" Foreground="White" BorderThickness="0"/>
                        <Button Command="{Binding RejectRequestCommand}" Content="TỪ CHỐI ĐƠN" Width="155" Height="41" Margin="10,0,0,0" Background="#B4515D" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                    <TextBlock Text="Duyệt chỉ thành công khi kho có đủ cuốn vật lý cho TẤT CẢ đầu sách. Nếu thiếu, không tạo phiếu một phần." Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#776887"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
